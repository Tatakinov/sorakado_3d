[configuration]

entry_symbol = "unix_client_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "./libgdunix_client.macos.template_debug.dylib"
macos.release = "./libgdunix_client.macos.template_release.dylib"
windows.debug.x86_32 = "./gdunix_client.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "./gdunix_client.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "./gdunix_client.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./gdunix_client.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./libgdunix_client.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./libgdunix_client.linux.template_release.x86_64.so"
linux.debug.arm64 = "./libgdunix_client.linux.template_debug.arm64.so"
linux.release.arm64 = "./libgdunix_client.linux.template_release.arm64.so"
linux.debug.rv64 = "./libgdunix_client.linux.template_debug.rv64.so"
linux.release.rv64 = "./libgdunix_client.linux.template_release.rv64.so"
